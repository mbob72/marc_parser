{
  "name": "marc-parser",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binary": "node scripts/build-binary.mjs",
    "dev": "tsx src/cli.ts",
    "smoke:binary": "node scripts/smoke-test.mjs release/marc-parser",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "bun": "1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
