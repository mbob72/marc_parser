{
  "name": "marc-parser",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binary": "node scripts/build-binary.mjs",
    "dev": "tsx src/cli.ts",
    "smoke:binary": "node scripts/smoke-test.mjs release/marc-parser",
    "start": "node dist/cli.js",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "bun": "1.3.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "amqplib": "^2.0.1",
    "fastify": "^5.11.0",
    "iconv-lite": "^0.7.3",
    "minio": "^8.0.7",
    "pg": "^8.22.0",
    "zod": "^4.5.4"
  }
}
